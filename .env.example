## AI provider selection
# Use: xai or mistral
VITE_AI_PROVIDER=xai

## Model override for selected provider
# X.AI default: grok-2-vision-1212
# Mistral default: pixtral-12b-2409
VITE_AI_MODEL=grok-2-vision-1212

## Provider API keys
# Fill only the key for the provider you use
VITE_XAI_API_KEY=your_xai_api_key_here
VITE_MISTRAL_API_KEY=your_mistral_api_key_here
